  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Luci rosse tonde = vita della lastra.

    Lampade ambra alte = attacco:
    le sedi sono tre, quante ne servono davvero.

    Tubi azzurri bassi = guardia,
    cinque sedi.

    Il colpo che sfonda la lastra arriva al boss; quello che sfonda
    la carta arriva a te.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
