{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "router/auto",
  "default_agent": "auto",
  "provider": {
    "llamacpp": {
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B locale",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "router": {
      "name": "FlipCards Auto gratuito",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "auto": {
          "name": "Auto gratuito - benchmark + locale",
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "vista": {
          "name": "Vista - benchmark immagini",
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "cervello": {
          "name": "Analisi - benchmark logica",
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "codice": {
          "name": "Codice - benchmark implementazione",
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "rapido": {
          "name": "Locale rapido - Qwen 2B",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "limit": {
            "context": 16384,
            "output": 2048
          }
        },
        "locale": {
          "name": "Solo locale - Qwen 9B",
          "tool_call": true,
          "attachment": false,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "coordinatore": {
          "name": "Coordinatore locale - Qwen 2B, contesto 32k",
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "unity-mcp": {
      "type": "local",
      "command": [
        "C:/Users/vulpi/.unity/relay/relay_win.exe",
        "--mcp",
        "--project-path",
        "C:/Users/vulpi/OneDrive/Documenti/UnityProj/FlipCards"
      ],
      "timeout": 60000
    }
  },
  "compaction": {
    "auto": true,
    "threshold_percent": 70,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 6000
  },
  "small_model": "router/rapido"
}
